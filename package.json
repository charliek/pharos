{
  "name": "pharos",
  "version": "0.1.0",
  "description": "Black-box functional test suite for validating a new service against a legacy one during migration",
  "type": "module",
  "license": "MIT",
  "author": "Charlie Knudsen",
  "repository": {
    "type": "git",
    "url": "https://github.com/charliek/pharos.git"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "pharos": "./src/cli/index.ts"
  },
  "scripts": {
    "ftest": "bun run src/cli/index.ts",
    "pharos": "bun run src/cli/index.ts",
    "example:serve": "bun run examples/serve.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
